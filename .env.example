# Timezone configuration
TZ=Europe/London

# Host user (UID) and group (GID) to ensure correct file permissions
PUID=1000
PGID=1000

# Primary Beancount ledger filename inside the mounted /workspace directory
BEANCOUNT_FILE=main.bean

# Optional Git identity for fava-git version control
GIT_AUTHOR_NAME=fava
GIT_AUTHOR_EMAIL=fava@homelab

# Scheduled auto-commit cron expression (e.g. "*/15 * * * *" for every 15 mins, "0 * * * *" for hourly, "" to disable)
AUTO_COMMIT_CRON=
# AUTO_COMMIT_MESSAGE="Auto-commit: %Y-%m-%d %H:%M:%S UTC"

# Scheduled credit card repayment due date notification cron expression (e.g. "0 9 * * *" for daily at 09:00, "" to disable)
REPAYMENT_NOTIFY_CRON=
# Apprise-API endpoint (e.g. http://localhost:8000/notify or http://apprise:8000/notify)
APPRISE_API_URL=
# Stateless mode: target notification URLs (e.g. tgram://<bot_token>/<chat_id>, discord://<webhook_id>/<webhook_token>)
APPRISE_URLS=
# Stateful mode: preconfigured Apprise profile key or tags
APPRISE_KEY=
APPRISE_TAGS=
# Days before due date to alert (default: 7,3,1,0)
# REPAYMENT_NOTIFY_DAYS=7,3,1,0
